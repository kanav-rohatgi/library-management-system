# Local lab demo settings
MYSQL_DATABASE=library
MYSQL_USER=library
MYSQL_PASSWORD=demo-library-password
MYSQL_ROOT_PASSWORD=demo-root-password
LIBRARY_SEED_ENABLED=true
LIBRARY_ADMIN_PASSWORD=DemoAdmin123!
LIBRARY_LIBRARIAN_PASSWORD=DemoLibrarian123!
LIBRARY_STUDENT_PASSWORD=DemoStudent123!
# Optional Base64-encoded secret (at least 32 bytes before encoding).
# A blank value generates a fresh signing key at each backend startup.
LIBRARY_JWT_SECRET=
LIBRARY_JWT_LIFETIME=PT2H
LIBRARY_TIME_ZONE=Asia/Kolkata
LIBRARY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
